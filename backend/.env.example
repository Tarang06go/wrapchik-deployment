PORT=5000
NODE_ENV=development
TRUST_PROXY_HOPS=0
# Comma-separated exact browser origins in production; e.g. https://wrapchik.example
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

MONGO_URI=mongodb://127.0.0.1:27017/wrapchik
# Optional isolated demo database; demo seed scripts accept only local wrapchik_demo.
MONGO_DEMO_URI=mongodb://127.0.0.1:27017/wrapchik_demo

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRE=7d

# Local-only email OTP fallback: returns a short-lived code only to the development app.
# Must remain false outside NODE_ENV=development.
LOCAL_OTP_ENABLED=false

# Optional development-only generic sample menu. Keep false to use the real Wrapchik catalogue.
SEED_SAMPLE_CATALOGUE=false
SEED_DEMO_ACCOUNTS=false

# Legacy Cashfree settings are retained for historical orders only. New checkout does not use a payment gateway.
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
APP_PUBLIC_URL=

# Legacy gateway values are retained for existing Razorpay orders during migration only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# HTTPS email provider for hosted deployments (required on Render Free, which blocks SMTP ports).
# Set a sender address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Local-development alternative: Gmail SMTP requires 2-Step Verification + an App Password.
# When set, Gmail SMTP is used instead of Resend. Never use a regular Gmail password here.
# Do not set on Render Free; outbound SMTP ports are blocked by that plan.
SMTP_USER=
SMTP_APP_PASSWORD=

# Google Sign-In server audience: set this to the OAuth 2.0 Web application client ID.
# Native Android/iOS clients use this same web client ID to request an ID token;
# the backend validates that token and enforces the @thapar.edu domain.
GOOGLE_CLIENT_ID=

# Optional Expo push access token. A provider ticket still does not prove device delivery.
EXPO_ACCESS_TOKEN=

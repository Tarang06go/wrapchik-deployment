{
  "name": "wrapchik-frontend",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --host lan -c",
    "eas-build-pre-install": "node scripts/validate-api-url.cjs",
    "validate:api-url": "node scripts/validate-api-url.cjs",
    "check:native-runtime": "node scripts/check-native-runtime.cjs",
    "check:imports": "node scripts/check-undefined-identifiers.cjs",
    "check:routes": "node scripts/check-routes.cjs",
    "export:web": "node scripts/export-web.cjs",
    "test": "node --test && npm run check:imports",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "^2.11.4",
    "axios": "^1.6.7",
    "expo": "~57.0.33",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.23",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.21",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.14",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.31",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.28",
    "lucide-react-native": "^1.45.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-google-signin": "2.3.1",
    "react-native-nitro-modules": "0.37.2",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2"
  },
  "overrides": {
    "expo": {
      "@expo/fingerprint": {
        "minimatch": "11.0.1"
      }
    },
    "expo-router": {
      "query-string": {
        "decode-uri-component": "0.5.1"
      }
    }
  },
  "private": true
}

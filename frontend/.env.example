# Required for production/preview builds. Use an HTTPS URL reachable from the phone.
# Example: https://your-wrapchik-backend.example.com
EXPO_PUBLIC_API_URL=
# Public iOS OAuth client ID; app.config.js derives the required iOS URL scheme from it.
# Leave blank until native Google sign-in is configured in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Public Google OAuth client IDs. Android OAuth client must use package com.wrapchik.app and the EAS signing SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
